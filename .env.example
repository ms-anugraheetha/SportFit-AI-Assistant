# Copy to .env for local development. NEVER commit .env.
# Placeholders only - no real secrets belong in this file.

# --- Database (PostgreSQL) ---
# Local example: postgresql+psycopg://USER:PASSWORD@localhost:5432/sportfit
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# --- Hugging Face Inference Providers ---
# Token with permission to call Inference Providers (create at huggingface.co/settings/tokens)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx
# Must be a model/provider pair that supports tool calling. Optional ":provider" suffix pins a provider.
HF_MODEL=openai/gpt-oss-120b
HF_BASE_URL=https://router.huggingface.co/v1

# --- Staff authentication (added in Phase 3) ---
# Generate a hash with:  python -m app.cli hash-password
STAFF_USERNAME=staff
STAFF_PASSWORD_HASH=
# Long random string used for CSRF tokens; generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- App ---
APP_ENV=development
# Comma-separated list of allowed browser origins for CORS (leave empty when frontend is served by FastAPI)
CORS_ORIGINS=http://localhost:5173
